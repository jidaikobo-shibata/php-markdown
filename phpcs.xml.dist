<?xml version="1.0"?>
<ruleset name="Jidaikobo PHP Markdown">
    <description>Code style rules for the package.</description>

    <arg name="colors"/>
    <arg value="ps"/>
    <arg name="extensions" value="php"/>

    <file>src</file>
    <file>tests</file>
    <file>examples</file>

    <rule ref="PSR12"/>
</ruleset>
