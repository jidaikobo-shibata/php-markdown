{
    "name": "jidaikobo/php-markdown",
    "description": "A few additions to michelf/php-markdown",
    "type": "library",
    "license": "MIT",
    "keywords": ["markdown"],
    "autoload": {
        "psr-4": {
            "Jidaikobo\\": "src/"
        }
    },
    "authors": [
        {
            "name": "jidaikobo-shibata",
            "email": "shibata@jidaikobo.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "michelf/php-markdown": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.13.6",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "scripts": {
        "test": "php tests/regression.php",
        "phpstan": [
            "vendor/bin/phpstan analyse src/ --level=5"
        ],
        "compatibility": [
            "vendor/bin/phpcs --standard=vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 7.4- src tests examples/index.php"
        ],
        "codestyle": "vendor/bin/phpcs",
        "codestyle-fix": "vendor/bin/phpcbf"
    }
}
